   5 REM LINK CHAT CLIENT
   6 REM PORT 16384 DATA, 16385 CONTROL.
   7 REM RECEIVES LINES FROM THE HOST AND PRINTS
   8 REM THEM, AND SENDS ONE LINE OF ITS OWN A
   9 REM MOMENT AFTER IT STARTS. THE HOST
  10 REM (examples/link/chatroom.py) RELAYS EACH
  11 REM LINE TO EVERY OTHER SPECTRUM.
  15 REM --- YOUR NAME AND FIRST LINE ---
  20 LET N$="speccy"
  25 LET M$="hello from the 48k!"
  30 LET D=16384
  40 LET C=16385
  45 REM LOOP PASSES TO WAIT BEFORE SENDING
  50 LET W=400
  55 BORDER 5: PAPER 5: INK 0: CLS
  60 PRINT "chat as ";N$: PRINT
  70 REM --- MAIN LOOP ---
  80 IF IN C=1 THEN GO SUB 200: GO TO 80
  90 REM NOTHING WAITING: COUNT DOWN, THEN SEND
 100 IF W=0 THEN GO TO 80
 110 LET W=W-1
 120 IF W=0 THEN GO SUB 300
 130 GO TO 80
 195 REM --- RECEIVE A BYTE AND PRINT IT ---
 200 LET B=IN D
 210 OUT C,3
 220 IF IN C<>2 THEN GO TO 220
 230 OUT C,0
