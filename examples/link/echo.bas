  5 REM LINK ECHO: PRINTS EACH BYTE FROM THE HOST
  6 REM AND SENDS IT BACK, LETTERS IN CAPITALS
 10 LET D=16384
 20 LET C=16385
 30 IF IN C<>1 THEN GO TO 30
 40 LET B=IN D
 50 OUT C,3
 60 IF IN C<>2 THEN GO TO 60
 70 OUT C,0
 80 PRINT CHR$ B;
 90 IF B>=97 AND B<=122 THEN LET B=B-32
100 OUT D,B
110 GO TO 30
